# Seyra edge relay settings (TEMPLATE). Copy to an operator-private location outside Git, fill in the
# real values there, and pass that file to infra/edge/edge.sh. Never commit the filled-in copy.
EDGE_OWNER=<OWNER_LABEL_VALUE>
EDGE_NAME=seyra-edge
# Exact locked proxy image (nginx with the stream module) and an image that provides iptables for
# the namespace-local egress guard; both checked by image id.
EDGE_IMAGE=seyra/proxy:1.0.0-seyra1
EDGE_IMAGE_ID=<PROXY_IMAGE_ID>
EDGE_GUARD_IMAGE=<GUARD_IMAGE_REF>
EDGE_GUARD_IMAGE_ID=<GUARD_IMAGE_ID>
# The address clients use (the host's own LAN address) and the HTTPS port to publish there.
EDGE_PUBLISH_ADDR=<VM_LAN_ADDR>
EDGE_PUBLISH_PORT=<LAN_HTTPS_PORT>
# The approved client subnet(s), canonical a.b.c.d/n.
EDGE_CLIENT_CIDRS=<APPROVED_CLIENT_CIDR>
# The Seyra proxy's relay listener as published inside the nested host: <lab address>:<relay port>.
EDGE_UPSTREAM=<NESTED_HOST_LAB_ADDR>:<RELAY_PORT>
EDGE_LAB_NETWORK=seyra_offline_lab
EDGE_PUBLISH_NETWORK=seyra_edge
# Operator-private directory for the rendered edge.conf.
EDGE_CONF_DIR=<PRIVATE_DIR>/edge
# The serving installation, read (never changed) by `edge.sh stop` to establish that its relay trust
# for this edge's address is gone: its nested Docker daemon and its SEYRA_HOME.
EDGE_INNER_DOCKER_HOST=unix://<LAB>/run/docker.sock
EDGE_INNER_HOME=<LAB>/home
